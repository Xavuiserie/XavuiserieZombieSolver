<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>

		<!-- CONFIGURATION STANDALONE TOTALEMENT SÉCURISÉE -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<!-- EMBARQUE ET EXTRAIT PROPREMENT LES DLL NATIVES SANS LES CASSER -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- ON DÉSACTIVE L'ÉLAGAGE POUR ÉVITER LE CRASH DE RENDU XAML -->
		<PublishTrimmed>false</PublishTrimmed>

		<!-- CORRECTION : Désactivation de la compression pour intégrer les bibliothèques de liaison de données manquantes-->
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

		<!-- CORRECTION : Désactivation du ReadyToRun pour éviter les corruptions graphiques sur les PC sans outils de dév -->
		<PublishReadyToRun>false</PublishReadyToRun>
	</PropertyGroup>

</Project>
