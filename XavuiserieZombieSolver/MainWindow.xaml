<Window x:Class="XavuiserieZombieSolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XavuiserieZombieSolver"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= BLOC DES FILTRES (LIGNE 0) ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <!-- Définition de deux colonnes de largeur égale (50% / 50%) -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PREMIÈRE COMBOBOX : Rôle Utilisateur (Colonne 0) -->
            <StackPanel Grid.Column="0" Margin="15,0">
                <TextBlock Text="Emplacement lumière verte :" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,8" 
                   Foreground="#333333"/>

                <ComboBox x:Name="selectLumiere" 
                  Height="35" 
                  FontSize="14" 
                  Padding="8,5"
                  VerticalContentAlignment="Center"
                  SelectionChanged="Select_SelectionChanged"/>
            </StackPanel>

            <!-- DEUXIÈME COMBOBOX : Statut du Compte (Colonne 1) -->
            <StackPanel Grid.Column="1" Margin="15,0">
                <TextBlock Text="Emplacement cylindre :" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,8" 
                   Foreground="#333333"/>

                <ComboBox x:Name="selectCylindre" 
                  Height="35" 
                  FontSize="14" 
                  Padding="8,5"
                  VerticalContentAlignment="Center"
                  SelectionChanged="Select_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- ================= LE TABLEAU DATA GRID (LIGNE 1) ================= -->
        <DataGrid x:Name="GridResult" 
              Grid.Row="1" 
              AutoGenerateColumns="False" 
              CanUserAddRows="False"
              HeadersVisibility="Column"
              Background="White"
              BorderBrush="#CCCCCC"
              RowHeight="30"
              FontSize="14">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Valve" 
                                Binding="{Binding Key}" 
                                Width="6*"/>

                <DataGridTextColumn Header="Position" 
                                Binding="{Binding Value}" 
                                Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
