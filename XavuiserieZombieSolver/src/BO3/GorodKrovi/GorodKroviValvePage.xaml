<Page x:Class="XavuiserieZombieSolver.src.BO3.GorodKrovi.GorodKroviValvePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:XavuiserieZombieSolver.src.BO3.GorodKrovi"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GorodKroviValvePage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Ligne 0 : Bouton Retour -->
            <RowDefinition Height="Auto"/>
            <!-- Ligne 1 : Bloc des Filtres (Anciennement Ligne 0) -->
            <RowDefinition Height="*"/>
            <!-- Ligne 2 : Le Tableau DataGrid (Anciennement Ligne 1) -->
        </Grid.RowDefinitions>

        <!-- ================= BOUTON RETOUR (LIGNE 0) ================= -->
        <Button Grid.Row="0" 
            x:Name="BtnRetour"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="15,0,0,15"
            Padding="12,6"
            Background="#F3F3F3"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            Cursor="Hand"
            Click="BtnRetourBO3Menu_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Button.Resources>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🡠" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#333333"/>
                <TextBlock Text="Retour" FontSize="14" VerticalAlignment="Center" Foreground="#333333"/>
            </StackPanel>
        </Button>

        <!-- ================= BLOC DES FILTRES (LIGNE 1) ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <!-- Définition de deux colonnes de largeur égale (50% / 50%) -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PREMIÈRE COMBOBOX : Rôle Utilisateur (Colonne 0) -->
            <StackPanel Grid.Column="0" Margin="15,0">
                <TextBlock Text="Emplacement lumière verte :" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,8" 
                       Foreground="#333333"/>

                <ComboBox x:Name="selectLumiere" 
                      Height="35" 
                      FontSize="14" 
                      Padding="8,5"
                      VerticalContentAlignment="Center"
                      SelectionChanged="Select_SelectionChanged"/>
            </StackPanel>

            <!-- DEUXIÈME COMBOBOX : Statut du Compte (Colonne 1) -->
            <StackPanel Grid.Column="1" Margin="15,0">
                <TextBlock Text="Emplacement cylindre :" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,8" 
                       Foreground="#333333"/>

                <ComboBox x:Name="selectCylindre" 
                      Height="35" 
                      FontSize="14" 
                      Padding="8,5"
                      VerticalContentAlignment="Center"
                      SelectionChanged="Select_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- ================= LE TABLEAU DATA GRID (LIGNE 2) ================= -->
        <DataGrid x:Name="GridResult" 
              Grid.Row="2" 
              AutoGenerateColumns="False" 
              CanUserAddRows="False"
              HeadersVisibility="Column"
              Background="White"
              BorderBrush="#CCCCCC"
              RowHeight="30"
              FontSize="14">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Valve" 
                                Binding="{Binding Key}" 
                                Width="6*"/>

                <DataGridTextColumn Header="Position" 
                                Binding="{Binding Value}" 
                                Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
