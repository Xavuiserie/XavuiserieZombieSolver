<Page x:Class="XavuiserieZombieSolver.src.BO3.BO3MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:XavuiserieZombieSolver.src.BO3"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BO3MenuPage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" 
            x:Name="BtnRetour"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="15,0,0,15"
            Padding="12,6"
            Background="#F3F3F3"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            Cursor="Hand"
            Click="BtnRetourMenuPrincipal_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Button.Resources>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🡠" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#333333"/>
                <TextBlock Text="Retour au menu principal" FontSize="14" VerticalAlignment="Center" Foreground="#333333"/>
            </StackPanel>
        </Button>

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Call of Duty Black Ops 3" FontSize="24" Margin="0,0,0,20"/>
                <Button Content="Gorod Krovi" Padding="10" Click="BtnAllerGorodValve_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
